{
    "name": "medora/medora-authority",
    "description": "AI Authority Platform for WordPress — makes a site a trusted, machine-readable knowledge source for AI search engines and LLMs.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "ai", "geo", "seo", "knowledge-graph", "llms-txt", "schema", "eeat"],
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Medora\\Authority\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Medora\\Authority\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "check": ["@lint", "@analyse", "@test"]
    },
    "scripts-descriptions": {
        "test": "Unit suite. Fast, needs no WordPress install.",
        "test:integration": "Integration suite. Run bin/install-wp-tests.sh first."
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
