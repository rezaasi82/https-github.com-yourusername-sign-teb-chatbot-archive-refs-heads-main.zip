<?xml version="1.0"?>
<ruleset name="Medora Authority">
    <description>WordPress coding standards, adjusted for a PHP 8.2 codebase.</description>

    <file>includes</file>
    <file>medora-authority.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.4"/>
    <config name="testVersion" value="8.2-"/>

    <rule ref="WordPress">
        <!-- The codebase uses PSR-4 class-per-file naming, which is required
             for the autoloader and is incompatible with WordPress's
             class-*.php convention. -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- Short array syntax is used throughout; it is also what WPCS itself
             now recommends for new code. -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

        <!-- Yoda conditions add nothing under strict types and a static
             analyser, and hurt readability. -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Alignment rules fight constructor property promotion and match
             expressions. -->
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>

        <!-- The codebase intentionally uses snake_case-free method naming
             (camelCase) to match its PSR-4 structure. -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.MemberNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>

        <!-- Every direct query in this codebase targets a custom mdra_ table,
             where the core APIs do not apply. Caching is handled explicitly by
             Support\Cache where it matters, and annotated where it does not. -->
        <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
        <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="medora-authority"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="medora"/>
                <element value="Medora\Authority"/>
                <element value="MEDORA"/>
            </property>
        </properties>
    </rule>
</ruleset>
