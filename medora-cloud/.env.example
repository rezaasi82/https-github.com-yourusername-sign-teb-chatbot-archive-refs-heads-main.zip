# Medora Cloud configuration. Copy to `.env` and fill in.

# Port the service listens on.
PORT=8787

# Shared secret — MUST equal the "کلید امنیتی" set in the plugin under
# Medora AI → Integrations → Medora Cloud. Signs/verifies every heartbeat.
MEDORA_SECRET=change-me-to-a-long-random-string

# Token protecting the /admin dashboard, /admin/stream and /v1/alert.
ADMIN_TOKEN=another-long-random-token

# Telegram alerts (optional). Create a bot with @BotFather, get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto-update feed served at GET /v1/update/latest (optional, for Phase 8).
MEDORA_LATEST_VERSION=3.7.0
MEDORA_UPDATE_URL=
MEDORA_UPDATE_SHA256=

# Data file location (defaults to ./data/store.json).
# MEDORA_DATA=/var/lib/medora/store.json
