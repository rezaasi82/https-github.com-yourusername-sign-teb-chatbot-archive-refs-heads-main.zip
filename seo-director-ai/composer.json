{
    "name": "seodirector/seo-director-ai",
    "description": "AI-powered SEO management platform for WordPress — a virtual SEO Director that monitors, analyzes, prioritizes, explains, and recommends actions.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "woocommerce/action-scheduler": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "SEODirector\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SEODirector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress --extensions=php includes seo-director-ai.php uninstall.php",
        "analyze": "phpstan analyse --level=6 includes",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
