{
    "name": "seodirector/seo-director-ai",
    "description": "AI-powered SEO management platform for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "SEODirector\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SEODirector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml",
        "stan": "phpstan analyse includes --level=6",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
